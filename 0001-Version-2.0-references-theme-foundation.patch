+  --font-heading:"Playfair Display","Bodoni Moda",Georgia,serif; --font-body:"Montserrat",system-ui,sans-serif;
+  --heading-weight:700;
+  --radius-card:4px; --radius-pill:2px; --radius-arch:999px;
+  --shadow:0 1px 2px rgba(0,0,0,.06);
+  --space-3:1.25rem; --space-5:4rem;
+}
