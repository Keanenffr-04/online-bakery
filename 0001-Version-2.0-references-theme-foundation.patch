@@ -0,0 +1,64 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Theme preview | The Sweetest Bakery</title>
+<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@500;600&family=Inter:wght@400;600&family=Montserrat:wght@400;600&family=Playfair+Display:wght@600;700&display=swap">
+<link rel="stylesheet" href="themes/base.css">
+<link rel="stylesheet" href="themes/theme-classic.css">
+<link rel="stylesheet" href="themes/theme-cocoa.css">
+<link rel="stylesheet" href="themes/theme-pastel.css">
+<style>
+  body{background:#EEE;font-family:system-ui,sans-serif}
+  .page-head{padding:2rem 0 0;text-align:center;color:#333}
+  .theme-block{margin:2rem auto;max-width:960px;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,.15)}
+  .theme-label{background:#222;color:#fff;font:600 .8rem system-ui;letter-spacing:.1em;padding:.5rem 1rem;text-transform:uppercase}
+  .demo{display:grid;gap:2rem;grid-template-columns:1fr;align-items:center}
+  @media(min-width:720px){.demo{grid-template-columns:1fr 1fr}}
+  .logo-wrap{display:grid;place-items:center}
+  .logo-wrap img{width:min(260px,70%);aspect-ratio:1;object-fit:cover;object-position:center;
+    border-radius:var(--radius-card);background:#fff;clip-path:inset(4% 4% 4% 4%)}
+  .row{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1rem}
+</style>
+</head>
+<body>
+<div class="page-head container">
+  <h1 style="font-family:Georgia,serif">Theme preview</h1>
+  <p>Same layout, three sets of tokens. Pick your favourite, Becca.</p>
+</div>
+<!-- data-theme blocks: each one is a self-contained sample -->
+<div id="themes"></div>
+<script>
+// Config comes from one place: edit the list below to add/remove themes.
+const THEMES=[["classic","Classic Black & White"],["cocoa","Cocoa & Cream"],["pastel","Soft Pastel"]];
+const WA="https://wa.me/27833413166"; // matches config/business.json
+document.getElementById("themes").innerHTML=THEMES.map(([id,name])=>`
+<section class="theme-block" data-theme="${id}">
+  <div class="theme-label">${name}</div>
+  <div class="section" style="background:var(--bg)"><div class="container demo">
+    <div class="logo-wrap"><img src="../assets/logo/logo-original.jpeg" alt="The Sweetest Bakery logo"></div>
+    <div>
+      <p class="eyebrow">Handmade with love</p>
+      <h1>The Sweetest Bakery</h1>
+      <p>Cakes, cupcakes, cookies and bread, baked fresh by Becca.</p>
+      <div class="row">
+        <a class="btn" href="#">Browse the menu</a>
+        <a class="btn btn--ghost" href="#">Custom orders</a>
+        <a class="btn btn--whatsapp" href="${WA}">WhatsApp us</a>
+      </div>
+    </div>
+    <article class="card">
+      <div class="card__media" aria-hidden="true">🍰</div>
+      <div class="card__body">
+        <span class="badge">Cakes</span>
+        <h3 style="margin-top:.5rem">Chocolate Ganache Cake</h3>
+        <p>Sample card. Real products arrive in v4.</p>
+        <span class="card__price">R 450</span>
+      </div>
+    </article>
+  </div></div>
+</section>`).join("");
+</script>
+</body>
+</html>
diff --git a/src/themes/base.css b/src/themes/base.css
new file mode 100644
index 0000000..c6b4738
--- /dev/null
+++ b/src/themes/base.css
@@ -0,0 +1,30 @@
+/* base.css: layout + components. Uses ONLY theme tokens (see theme-*.css).
+   Themes change tokens, never layout. */
+*,*::before,*::after{box-sizing:border-box}
+html{-webkit-text-size-adjust:100%}
+body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font-body);line-height:1.6}
+h1,h2,h3{font-family:var(--font-heading);font-weight:var(--heading-weight);line-height:1.15;margin:0 0 .5em;color:var(--heading)}
+h1{font-size:clamp(2rem,6vw,3.25rem)}
+h2{font-size:clamp(1.5rem,4vw,2.1rem)}
+p{margin:0 0 1em}
+.container{max-width:960px;margin:0 auto;padding:0 var(--space-3)}
+.section{padding:var(--space-5) 0}
+.eyebrow{font-size:.75rem;letter-spacing:.18em;text-transform:uppercase;color:var(--accent)}
+
+.btn{display:inline-block;padding:.8em 1.6em;border-radius:var(--radius-pill);border:1.5px solid var(--btn-bg);
+  background:var(--btn-bg);color:var(--btn-text);font:600 .95rem var(--font-body);cursor:pointer;text-decoration:none;
+  transition:transform .15s ease,box-shadow .15s ease}
+.btn:hover{transform:translateY(-1px);box-shadow:var(--shadow)}
+.btn:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
+.btn--ghost{background:transparent;color:var(--btn-bg)}
+.btn--whatsapp{background:var(--whatsapp);border-color:var(--whatsapp);color:#fff}
+
+.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-card);
+  box-shadow:var(--shadow);overflow:hidden}
+.card__media{aspect-ratio:4/5;background:var(--surface-alt);
+  border-radius:var(--radius-arch) var(--radius-arch) 0 0; /* arch motif from the logo */
+  display:grid;place-items:center;font-size:3rem}
+.card__body{padding:var(--space-3)}
+.card__price{font-weight:700;color:var(--accent)}
+.badge{display:inline-block;padding:.2em .7em;border-radius:var(--radius-pill);background:var(--surface-alt);
+  color:var(--text);font-size:.75rem;border:1px solid var(--border)}
